{
  "name": "murmur",
  "version": "0.2.0",
  "description": "Read your notes aloud with karaoke-style highlighting.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
